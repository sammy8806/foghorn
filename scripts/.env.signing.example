# Copy this file to scripts/.env.signing and replace every placeholder.
# Never commit scripts/.env.signing.
#
# Encode binary credentials without line wrapping:
#   base64 -i DeveloperIDApplication.p12 | pbcopy
#   base64 -i AuthKey_XXXXXXXXXX.p8 | pbcopy

APPLE_DEVELOPER_ID_CERT_P12_BASE64='<base64-encoded Developer ID Application certificate and private key>'
APPLE_DEVELOPER_ID_CERT_PASSWORD='<password used when exporting the p12>'
APPLE_API_KEY_ID='<App Store Connect API key ID>'
APPLE_API_ISSUER_ID='<App Store Connect issuer ID>'
APPLE_API_KEY_P8_BASE64='<base64-encoded App Store Connect API private key>'
